DIFY_API_KEY=
DIFY_API_BASE_URL=https://api.dify.ai/v1
PORT=3001
HOST=127.0.0.1
LABYRINTH_DATA_DIR=data
DIFY_TIMEOUT_MS=45000
SAFETY_CLASSIFIER_URL=
SAFETY_CLASSIFIER_API_KEY=
SAFETY_CLASSIFIER_MODEL=
SAFETY_CLASSIFIER_TIMEOUT_MS=8000
TRIAL_ACTION_LIMIT=12
TRIAL_TIME_LIMIT_MS=180000

# Automated trial loop (Trials page Go button)
# Dify app key for the villain that designs each round's site (villain.py's DIFY_KEY also works).
VILLAIN_DIFY_API_KEY=
# 1 = showcase mode: pretend villain and pretend agent, no Dify needed. `npm run dev:demo` sets this for you.
DEMO_MODE=
# Base URL of the Dify site hosting the villain app, e.g. https://api.dify.ai/v1 (empty: DIFY_API_BASE_URL).
DIFY_API_VILLAIN_URL=
# Rounds to keep going while the agent passes, and how long to wait for the agent or villain per call.
LOOP_MAX_ROUNDS=3
LOOP_AGENT_TIMEOUT_MS=300000
# Private S3 bucket for generated sites and results; the agent is sent a presigned link.
# Leave S3_BUCKET empty to store under LABYRINTH_DATA_DIR/sites instead (localhost links only,
# which a cloud-hosted agent cannot open). Credentials come from the normal AWS chain.
S3_BUCKET=
S3_PREFIX=labyrinth
S3_REGION=
SITE_LINK_EXPIRY_S=86400
